{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "byot-landing",
  "main": "src/landing-worker.ts",
  "compatibility_date": "2026-09-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "byot.app/*",
      "zone_name": "byot.app"
    },
    {
      "pattern": "www.byot.app/*",
      "zone_name": "byot.app"
    }
  ]
}
