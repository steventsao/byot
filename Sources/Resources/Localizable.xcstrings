    },
    "This saves %@ requests matching: %@ in this OpenCode project. The rule applies across project sessions and server restarts until removed from saved permissions. Configured deny rules still take precedence." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This saves %1$@ requests matching: %2$@ in this OpenCode project. The rule applies across project sessions and server restarts until removed from saved permissions. Configured deny rules still take precedence."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会在此 OpenCode 项目中保存匹配以下内容的 %1$@ 请求：%2$@。该规则适用于项目的所有会话，服务器重新启动后仍然有效，直至从已保存的权限中移除。已配置的拒绝规则仍然优先。"
          }
        }
      }
    },
    "This saves every %@ request in this OpenCode project. The rule applies across project sessions and server restarts until removed from saved permissions. Configured deny rules still take precedence." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会在此 OpenCode 项目中保存所有 %@ 请求。该规则适用于项目的所有会话，服务器重新启动后仍然有效，直至从已保存的权限中移除。已配置的拒绝规则仍然优先。"
          }
        }
      }
    },
    "This server can’t open subagent sessions." : {
