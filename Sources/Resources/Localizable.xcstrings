    },
    "While this OpenCode instance remains active, this allows %@ requests matching: %@ in this directory. The rule is kept in memory and is not persisted." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "While this OpenCode instance remains active, this allows %1$@ requests matching: %2$@ in this directory. The rule is kept in memory and is not persisted."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此 OpenCode 实例保持活跃期间，这会允许此目录中匹配以下内容的 %1$@ 请求：%2$@。该规则保存在内存中，不会持久保存。"
          }
        }
      }
    },
    "While this OpenCode instance remains active, this allows every %@ request in this directory. The rule is kept in memory and is not persisted." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此 OpenCode 实例保持活跃期间，这会允许此目录中的所有 %@ 请求。该规则保存在内存中，不会持久保存。"
          }
        }
      }
    },
