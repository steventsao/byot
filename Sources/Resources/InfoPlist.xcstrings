{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "comment": "Permission prompt for scanning a pairing code",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "byot 仅使用相机扫描 OpenCode 服务器的配对码。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "byot uses the camera only to scan the pairing code for your OpenCode server."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "comment": "Permission prompt for finding servers on the local network",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "byot 会查找你网络中的 OpenCode 服务器，并连接你通过本地地址添加的服务器。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "byot finds OpenCode servers on your network and connects to the ones you add by local address."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Permission prompt for dictation",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "byot 仅在你轻点麦克风并听写消息时收听。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "byot listens only while you dictate a message, and only after you tap the microphone."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "comment": "Permission prompt for speech recognition during dictation",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "byot 会将你的听写内容转换为消息文本。如果你的语言支持，语音会在本设备上转写；否则由 Apple 转写。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "byot turns what you dictate into message text. Speech is transcribed on this device when your language supports it; otherwise Apple transcribes it."
          }
        }
      }
    }
  },
  "version": "1.0"
}
