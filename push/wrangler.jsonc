{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "byot-push",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "APNS_TEAM_ID": "449BD89VDV", "APNS_TOPIC": "com.steventsao.byot" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "byot-push",
      "database_id": "b8f64534-4cd8-4d47-9fd2-231c20474744",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "7301",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
}
